<?xml version="1.0"?>
<!--
  sxd_arm: the reference 6-DOF manipulator the kiosk retargets UMI motion
  onto. Primitive geometry only (no meshes) so urdf-loader renders it with
  zero asset dependencies; swap this file for the customer's real URDF to
  retarget against their robot. Reach is ~0.85 m from the shoulder.
-->
<robot name="sxd_arm">
  <material name="graphite"><color rgba="0.16 0.15 0.14 1.0"/></material>
  <material name="steel"><color rgba="0.42 0.40 0.38 1.0"/></material>
  <material name="amber"><color rgba="0.96 0.48 0.10 1.0"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry><cylinder radius="0.07" length="0.05"/></geometry>
      <material name="graphite"/>
    </visual>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="150" velocity="3.1"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.04"/>
      <geometry><cylinder radius="0.055" length="0.08"/></geometry>
      <material name="steel"/>
    </visual>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.08"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="150" velocity="3.1"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry><box size="0.055 0.055 0.30"/></geometry>
      <material name="graphite"/>
    </visual>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.30"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="80" velocity="3.1"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.125"/>
      <geometry><box size="0.045 0.045 0.25"/></geometry>
      <material name="steel"/>
    </visual>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="0 0 0.25"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="30" velocity="3.9"/>
  </joint>

  <link name="wrist_1_link">
    <visual>
      <origin xyz="0 0 0.03"/>
      <geometry><cylinder radius="0.035" length="0.06"/></geometry>
      <material name="graphite"/>
    </visual>
  </link>

  <joint name="joint_5" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 0 0.06"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="30" velocity="3.9"/>
  </joint>

  <link name="wrist_2_link">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry><cylinder radius="0.03" length="0.05"/></geometry>
      <material name="steel"/>
    </visual>
  </link>

  <joint name="joint_6" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="15" velocity="3.9"/>
  </joint>

  <link name="gripper_link">
    <visual>
      <origin xyz="0 0 0.03"/>
      <geometry><box size="0.03 0.09 0.06"/></geometry>
      <material name="amber"/>
    </visual>
  </link>

  <joint name="tool_joint" type="fixed">
    <parent link="gripper_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.07"/>
  </joint>

  <link name="tool0"/>
</robot>
